{
  "name": "my-astro-project-using-bun",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "client": "bun run --bun astro dev",
    "build:client": "bun run --bun astro build",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --write .",
    "format-check": "prettier --check .",
    "lint": "eslint 'src/**/*.{js,ts,tsx,astro}'",
    "worker": "wrangler dev",
    "dev": "concurrently \"bun run client\" \"bun run worker\"",
    "dryrun:staging": "bun run build:client && bun run wrangler deploy --dry-run --env staging",
    "dryrun:production": "bun run build:client && bun run wrangler deploy --dry-run --env production",
    "deploy:production": "bun run build:client && bun run wrangler deploy --env production",
    "deploy:staging": "bun run build:client && bun run wrangler deploy --env staging"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react-dom": "^19.2.4",
    "astro": "^7.1.6",
    "axios": "^1.19.0",
    "concurrently": "^10.0.4",
    "hono": "^4.13.0",
    "jose": "^6.2.8",
    "lucide-react": "^1.29.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.119.0"
  },
  "devDependencies": {
    "@astrojs/react": "^6.0.2",
    "@types/react": "^19.2.18",
    "@typescript-eslint/parser": "^8.66.0",
    "daisyui": "^5.7.16",
    "eslint": "^10.8.0",
    "eslint-plugin-astro": "^3.1.0",
    "prettier-plugin-tailwindcss": "^0.8.1"
  }
}
